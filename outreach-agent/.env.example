# App-level secrets only. Per-customer values (Gmail connection, sheet id,
# sender name, calendar link, notify email) are set per account in the web
# app's Settings page, not here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
APP_SECRET_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Both must be registered as authorized redirect URIs on the same Google
# OAuth client: GOOGLE_OAUTH_REDIRECT_URI connects Gmail/Sheets after login;
# GOOGLE_LOGIN_REDIRECT_URI is the "Sign in with Google" identity flow.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
