# App-level secrets only. Per-customer values (Gmail connection, sheet id,
# sender name, calendar link, notify email) are set per account in the web
# app's Settings page, not here.
# --- Language models --------------------------------------------------------
# At least one key. Tried in order (see LLM_PROVIDER_ORDER); the first that
# answers serves the request, so a blown daily quota degrades instead of
# stopping. Verify the model ids against each provider's current list.
#
# {NAME}_TIER=free|paid declares the data terms your key is on. It is not
# cosmetic: a free tier generally allows training on what you send, so reply
# drafts -- which carry the prospect's own words -- only go to a provider marked
# paid, and are never failed over to a free one. See providers.py.

# Highest free ceiling (~14.4k requests/day, 30 RPM), no card required.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIER=paid

# Google AI Studio (~1.5k requests/day). Free-tier data may be used to improve
# Google's products, hence the default tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIER=paid

# 50 requests/day on an account that has never been funded -- too low to be a
# primary. Tier is inferred from the model id's :free suffix.
OPENROUTER_API_KEY=
# Validation week: paid mid-tier model for demo-grade drafts (G6, CEO review 2026-07-19)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Reorders the chain, and doubles as an allowlist: a provider left out is not
# used even if its key is set. LLM_PROVIDER_ORDER=groq pins everything to Groq.
# LLM_PROVIDER_ORDER=cliproxy,groq,gemini,openrouter

# Refuse to draft a reply at all rather than send the prospect's words to a
# free-tier endpoint. Turn on once a paid provider is configured.
# REPLY_DRAFTS_REQUIRE_PRIVATE_ENDPOINT=1

# Local-dev-only: point _chat() at a CLIProxyAPI instance on this machine
# instead of a hosted provider. Leave all three empty/unset in every real
# deployment.
CLIPROXY_BASE_URL=
CLIPROXY_API_KEY=
CLIPROXY_MODEL=claude-haiku-4-5-20251001
APP_SECRET_KEY=
# Optional: signs session/OAuth-state/unsubscribe tokens (auth.py), separate
# from APP_SECRET_KEY (which derives the Fernet key encrypting stored Google
# tokens). Defaults to APP_SECRET_KEY when unset -- no action needed unless
# you want the two secrets to actually differ. Rotating it logs everyone out
# (sessions are short-lived) but does not break previously sent unsubscribe
# links, which verify against the old value too.
# SESSION_SIGNING_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Both must be registered as authorized redirect URIs on the same Google
# OAuth client: GOOGLE_OAUTH_REDIRECT_URI connects Gmail/Sheets after login;
# GOOGLE_LOGIN_REDIRECT_URI is the "Sign in with Google" identity flow.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Set to 1 when serving over HTTPS (e.g. the cloudflared tunnel) so session
# cookies are never sent over plain http. Leave unset for local development.
# SECURE_COOKIES=1

# --- Stripe (optional) --------------------------------------------------------
# All optional. Unset means checkout is switched off and every account stays on
# the free trial -- which is the right state for a self-hosted single-tenant
# install. Test-mode keys (sk_test_/whsec_) work unchanged.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook REFUSES every event rather than trusting
# it: the endpoint is public, so the signature is the only thing standing
# between a stranger's POST and a free paid plan.
STRIPE_WEBHOOK_SECRET=
# Price ids per tier and billing period, created in the Stripe dashboard.
STRIPE_PRICE_PILOT=
STRIPE_PRICE_PILOT_YEARLY=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_YEARLY=

# Per-plan now (see plans.py). Setting this OVERRIDES every plan's daily cap
# for the whole deployment -- intended for self-hosters with no plans at all.
# Leave unset in any deployment that sells tiers.
# DAILY_SEND_LIMIT=25
